# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Created when you register the webhook in the PayPal dashboard
PAYPAL_WEBHOOK_ID=

# Anthropic API key (console.anthropic.com). Set a monthly spend limit on it.
ANTHROPIC_API_KEY=

# Postgres connection string (for example from Neon). Leave empty to use a local SQLite file.
DATABASE_URL=

# Demo controls (demo clock and "run jobs now"). Set to false outside a demo.
DEMO_MODE=true
# How often reminders and overdue checks run in the background, in minutes. 0 turns it off.
JOBS_INTERVAL_MINUTES=60
