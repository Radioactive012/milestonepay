# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Created when you register the webhook in the PayPal dashboard
PAYPAL_WEBHOOK_ID=

# Anthropic API key (console.anthropic.com). Set a monthly spend limit on it.
ANTHROPIC_API_KEY=

# Postgres connection string (for example from Neon)
DATABASE_URL=
