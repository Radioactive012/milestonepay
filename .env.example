# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Created when you register the webhook in the PayPal dashboard
PAYPAL_WEBHOOK_ID=

# OpenRouter API key (openrouter.ai/keys). Give the key a credit limit so it can't overspend.
OPENROUTER_API_KEY=
# The AI model, as named on OpenRouter
AI_MODEL=deepseek/deepseek-v4.1-flash-1017
# Most real AI calls allowed per day, for everyone together. 0 turns the AI off.
AI_DAILY_LIMIT=150

# Postgres connection string (for example from Neon). Leave empty to use a local SQLite file.
DATABASE_URL=

# Demo controls (demo clock, run jobs, load and reset the demo). Set to false outside a demo.
DEMO_MODE=true
# The sandbox Personal account email that pays the demo project's invoices
DEMO_CLIENT_EMAIL=
# How often reminders and overdue checks run in the background, in minutes. 0 turns it off.
JOBS_INTERVAL_MINUTES=60
